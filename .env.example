# ── Core ─────────────────────────────────────────────────────────────
# On Railway: the shared Postgres, in this app's own schema (see DEPLOYMENT.md §3)
DATABASE_URL=${{Postgres.DATABASE_URL}}?schema=task_monitor
APP_URL=https://your-app.up.railway.app
# Long random string (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
# Super admins / managers (comma separated). More can be promoted in Settings.
ADMIN_EMAILS=mohammed@growthmaksolutions.com
# Optional: let anyone with this email domain sign in even before Zoho sync has seen them
ALLOWED_EMAIL_DOMAIN=growthmaksolutions.com
# true = seed/demo data and a "view as" picker on the login page. Keep false in production.
DEMO_MODE=false

# ── Zoho (India data centre) ─────────────────────────────────────────
# api-console.zoho.in → Server-based Application
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_PROJECTS_API=https://projectsapi.zoho.in
ZOHO_PROJECTS_WEB=https://projects.zoho.in
ZOHO_PORTAL_NAME=growthmak
# Optional — found automatically from the portal name
ZOHO_PORTAL_ID=
# Optional — normally set by Settings → Connect Zoho Projects
ZOHO_REFRESH_TOKEN=
# Random string; goes on the webhook URL as ?secret=
ZOHO_WEBHOOK_SECRET=
# Project custom-field labels that hold the client name / type
ZOHO_CLIENT_FIELD_LABELS=Client,Client Name
ZOHO_CLIENT_TYPE_FIELD_LABELS=Client Type,Type,Category
# Names that count as internal when Zoho doesn't say
INTERNAL_CLIENT_NAMES=Growthmak,GrowthOS,Internal
# Optional exact status → column mapping (READY, IN_PROGRESS, BLOCKED, REVIEW, COMPLETED, IGNORE)
# STATUS_MAP={"Waiting on client":"BLOCKED","Q&A":"REVIEW"}

# ── Zoho Cliq alerts ─────────────────────────────────────────────────
CLIQ_API_BASE=https://cliq.zoho.in
# Channel unique name (Channel → More info → Connectors → API endpoint)
CLIQ_CHANNEL=
# Cliq → profile → Bots & Tools → Webhook tokens → Generate
CLIQ_WEBHOOK_TOKEN=
# Optional: post as a bot that is already a member of the channel
CLIQ_BOT_NAME=

# ── Jobs ─────────────────────────────────────────────────────────────
RUN_JOBS=true
SYNC_ON_BOOT=true
SYNC_INTERVAL_MIN=15
CONFIDENCE_INTERVAL_MIN=30
# Only needed if you trigger /api/cron/<job> from outside
CRON_SECRET=
