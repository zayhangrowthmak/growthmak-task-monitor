{
  "name": "growthmak-task-monitor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && next start -p ${PORT:-3000}",
    "db:migrate": "prisma migrate dev",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "zoho:discover": "tsx scripts/zoho-discover.ts",
    "zoho:sync": "tsx scripts/zoho-sync.ts",
    "test": "tsx --test lib/confidence.test.ts && tsx test/run-e2e.mts",
    "test:unit": "tsx --test lib/confidence.test.ts",
    "test:e2e": "tsx test/run-e2e.mts",
    "check": "tsx scripts/check-connections.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.9.0",
    "jose": "^5.10.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}